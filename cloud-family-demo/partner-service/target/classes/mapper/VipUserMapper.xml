<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kfpd.cloud.partner.dao.VipUserDao">

    <resultMap id="VipUserResultMap" type="com.kfpd.cloud.partner.pojo.entity.VipUser">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="displayName" column="display_name"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="vipLevel" column="vip_level"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="VipUserColumns">
        id, username, password_hash, display_name, email, phone, vip_level, status, created_at, updated_at
    </sql>

    <sql id="VipUserFilters">
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="displayName != null and displayName != ''">
                AND display_name LIKE CONCAT('%', #{displayName}, '%')
            </if>
            <if test="vipLevel != null and vipLevel != ''">
                AND vip_level = #{vipLevel}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </sql>

    <select id="findPage" resultMap="VipUserResultMap">
        SELECT <include refid="VipUserColumns"/>
        FROM vip_user
        <include refid="VipUserFilters"/>
        ORDER BY id DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM vip_user
        <include refid="VipUserFilters"/>
    </select>

    <select id="findById" resultMap="VipUserResultMap">
        SELECT <include refid="VipUserColumns"/>
        FROM vip_user
        WHERE id = #{id}
    </select>

    <select id="findByUsername" resultMap="VipUserResultMap">
        SELECT <include refid="VipUserColumns"/>
        FROM vip_user
        WHERE username = #{username}
          AND status = 'ENABLED'
    </select>

    <insert id="insert" parameterType="com.kfpd.cloud.partner.pojo.entity.VipUser"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO vip_user (username, password_hash, display_name, email, phone, vip_level, status)
        VALUES (#{username}, #{passwordHash}, #{displayName}, #{email}, #{phone}, #{vipLevel}, #{status})
    </insert>

    <update id="update" parameterType="com.kfpd.cloud.partner.pojo.entity.VipUser">
        UPDATE vip_user
        SET username = #{username},
            password_hash = #{passwordHash},
            display_name = #{displayName},
            email = #{email},
            phone = #{phone},
            vip_level = #{vipLevel},
            status = #{status}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM vip_user
        WHERE id = #{id}
    </delete>
</mapper>
