<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kfpd.cloud.manager.dao.SysMenuDao">

    <resultMap id="SysMenuResultMap" type="com.kfpd.cloud.manager.pojo.entity.SysMenu">
        <id property="id" column="id"/>
        <result property="parentId" column="parent_id"/>
        <result property="menuCode" column="menu_code"/>
        <result property="menuName" column="menu_name"/>
        <result property="path" column="path"/>
        <result property="component" column="component"/>
        <result property="icon" column="icon"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="visible" column="visible"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="SysPermissionResultMap" type="com.kfpd.cloud.manager.pojo.entity.SysPermission">
        <id property="id" column="id"/>
        <result property="permissionCode" column="permission_code"/>
        <result property="permissionName" column="permission_name"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="SysMenuColumns">
        id, parent_id, menu_code, menu_name, path, component, icon, sort_order, visible, status, created_at, updated_at
    </sql>

    <select id="findAll" resultMap="SysMenuResultMap">
        SELECT <include refid="SysMenuColumns"/>
        FROM sys_menu
        ORDER BY sort_order ASC, id DESC
    </select>

    <select id="findById" resultMap="SysMenuResultMap">
        SELECT <include refid="SysMenuColumns"/>
        FROM sys_menu
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.kfpd.cloud.manager.pojo.entity.SysMenu"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_menu (parent_id, menu_code, menu_name, path, component, icon, sort_order, visible, status)
        VALUES (#{parentId}, #{menuCode}, #{menuName}, #{path}, #{component}, #{icon}, #{sortOrder}, #{visible}, #{status})
    </insert>

    <update id="update" parameterType="com.kfpd.cloud.manager.pojo.entity.SysMenu">
        UPDATE sys_menu
        SET parent_id = #{parentId},
            menu_code = #{menuCode},
            menu_name = #{menuName},
            path = #{path},
            component = #{component},
            icon = #{icon},
            sort_order = #{sortOrder},
            visible = #{visible},
            status = #{status}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_menu
        WHERE id = #{id}
    </delete>

    <select id="findPermissionsByMenuId" resultMap="SysPermissionResultMap">
        SELECT p.id, p.permission_code, p.permission_name, p.description, p.status, p.created_at, p.updated_at
        FROM sys_permission p
        INNER JOIN sys_menu_permission mp ON mp.permission_id = p.id
        WHERE mp.menu_id = #{menuId}
        ORDER BY p.permission_code ASC
    </select>

    <delete id="deleteMenuPermissions">
        DELETE FROM sys_menu_permission
        WHERE menu_id = #{menuId}
    </delete>

    <insert id="insertMenuPermission">
        INSERT IGNORE INTO sys_menu_permission (menu_id, permission_id)
        VALUES (#{menuId}, #{permissionId})
    </insert>
</mapper>
