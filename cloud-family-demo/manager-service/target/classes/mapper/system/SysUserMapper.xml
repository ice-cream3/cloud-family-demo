<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kfpd.cloud.manager.dao.SysUserDao">

    <resultMap id="SysUserResultMap" type="com.kfpd.cloud.manager.pojo.entity.SysUser">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="displayName" column="display_name"/>
        <result property="email" column="email"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="SysRoleResultMap" type="com.kfpd.cloud.manager.pojo.entity.SysRole">
        <id property="id" column="id"/>
        <result property="roleCode" column="role_code"/>
        <result property="roleName" column="role_name"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="SysPermissionResultMap" type="com.kfpd.cloud.manager.pojo.entity.SysPermission">
        <id property="id" column="id"/>
        <result property="permissionCode" column="permission_code"/>
        <result property="permissionName" column="permission_name"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="SysMenuResultMap" type="com.kfpd.cloud.manager.pojo.entity.SysMenu">
        <id property="id" column="id"/>
        <result property="parentId" column="parent_id"/>
        <result property="menuCode" column="menu_code"/>
        <result property="menuName" column="menu_name"/>
        <result property="path" column="path"/>
        <result property="component" column="component"/>
        <result property="icon" column="icon"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="visible" column="visible"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="SysUserColumns">
        id, username, password_hash, display_name, email, status, created_at, updated_at
    </sql>

    <select id="findAll" resultMap="SysUserResultMap">
        SELECT <include refid="SysUserColumns"/>
        FROM sys_user
        ORDER BY id DESC
    </select>

    <select id="findById" resultMap="SysUserResultMap">
        SELECT <include refid="SysUserColumns"/>
        FROM sys_user
        WHERE id = #{id}
    </select>

    <select id="findByUsername" resultMap="SysUserResultMap">
        SELECT <include refid="SysUserColumns"/>
        FROM sys_user
        WHERE username = #{username}
    </select>

    <insert id="insert" parameterType="com.kfpd.cloud.manager.pojo.entity.SysUser"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (username, password_hash, display_name, email, status)
        VALUES (#{username}, #{passwordHash}, #{displayName}, #{email}, #{status})
    </insert>

    <update id="update" parameterType="com.kfpd.cloud.manager.pojo.entity.SysUser">
        UPDATE sys_user
        SET username = #{username},
            password_hash = #{passwordHash},
            display_name = #{displayName},
            email = #{email},
            status = #{status}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_user
        WHERE id = #{id}
    </delete>

    <select id="findRolesByUserId" resultMap="SysRoleResultMap">
        SELECT r.id, r.role_code, r.role_name, r.description, r.status, r.created_at, r.updated_at
        FROM sys_role r
        INNER JOIN sys_user_role ur ON ur.role_id = r.id
        WHERE ur.user_id = #{userId}
        ORDER BY r.id DESC
    </select>

    <select id="findPermissionsByUserId" resultMap="SysPermissionResultMap">
        SELECT DISTINCT p.id, p.permission_code, p.permission_name, p.description, p.status, p.created_at, p.updated_at
        FROM sys_permission p
        INNER JOIN sys_role_permission rp ON rp.permission_id = p.id
        INNER JOIN sys_user_role ur ON ur.role_id = rp.role_id
        WHERE ur.user_id = #{userId}
        ORDER BY p.permission_code ASC
    </select>

    <select id="findMenusByUserId" resultMap="SysMenuResultMap">
        SELECT DISTINCT m.id, m.parent_id, m.menu_code, m.menu_name, m.path, m.component, m.icon,
                        m.sort_order, m.visible, m.status, m.created_at, m.updated_at
        FROM sys_menu m
        INNER JOIN sys_role_menu rm ON rm.menu_id = m.id
        INNER JOIN sys_user_role ur ON ur.role_id = rm.role_id
        WHERE ur.user_id = #{userId}
        ORDER BY m.sort_order ASC, m.menu_code ASC
    </select>

    <delete id="deleteUserRoles">
        DELETE FROM sys_user_role
        WHERE user_id = #{userId}
    </delete>

    <insert id="insertUserRole">
        INSERT INTO sys_user_role (user_id, role_id)
        VALUES (#{userId}, #{roleId})
    </insert>
</mapper>
